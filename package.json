{
  "name": "9-lesson",
  "version": "1.0.0",
  "description": "Node.js + Express + TypeScript Starter Boilerplate",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "npm run contract:emit && tsc",
    "start": "tsx src/server.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "studio": "tsx src/prisma/studio.ts",
    "prod": "pm2 start dist/server.js -i max",
    "prod:docker": "pm2-runtime start dist/server.js -i max",
    "dev:db": "npm run contract:emit && npm run db:init && npm run dev"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@prisma/cli-engine": "^0.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "prisma": "^8.0.0-rc.34",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.24",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.23.15"
  }
}
